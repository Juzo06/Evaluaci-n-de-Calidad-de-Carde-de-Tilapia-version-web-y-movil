            <staticText>
                <reportElement x="0" y="660" width="515" height="20" forecolor="#4D6A80"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[SECCT · Sistema de Evaluación de Calidad de Carne de Tilapia · Documento generado con estadísticas consolidadas]]></text>
