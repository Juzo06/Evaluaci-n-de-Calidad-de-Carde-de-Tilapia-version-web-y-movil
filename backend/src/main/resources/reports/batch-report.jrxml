            <!-- Fila Categoría 4 -->
            <staticText>
                <reportElement x="0" y="592" width="235" height="22" mode="Opaque" backcolor="#F4F8FB" forecolor="#003465"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#C8DCE8"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Categoría 4 (Buena frescura)]]></text>
            </staticText>
            <textField>
                <reportElement x="235" y="592" width="140" height="22" mode="Opaque" backcolor="#F4F8FB"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#C8DCE8"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
