                </textElement>
                <textFieldExpression><![CDATA[$P{cat2Pct}]]></textFieldExpression>
            </textField>

            <!-- Fila Categoría 3 -->
            <staticText>
                <reportElement x="0" y="570" width="235" height="22" mode="Opaque" backcolor="#FFFFFF" forecolor="#003465"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#C8DCE8"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Categoría 3 (Frescura aceptable)]]></text>
            </staticText>
            <textField>
                <reportElement x="235" y="570" width="140" height="22" mode="Opaque" backcolor="#FFFFFF"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#C8DCE8"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{cat3Count}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="375" y="570" width="140" height="22" mode="Opaque" backcolor="#FFFFFF"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#C8DCE8"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{cat3Pct}]]></textFieldExpression>
