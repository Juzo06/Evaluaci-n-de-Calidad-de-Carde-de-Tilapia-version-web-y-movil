        <UserObject label="Transacciones del log (PostgreSQL READ_COMMITTED + FKs):&lt;br&gt;1. recordEvent usa @Transactional(propagation = REQUIRED) para participar en la&lt;br&gt;transacción principal, viendo userId/batchId/evaluationId recién insertados sin violar FKs.&lt;br&gt;2. recordSecurityFailure usa @Transactional(propagation = REQUIRES_NEW) exclusivamente&lt;br&gt;en LOGIN_FAILED / accesos denegados sobre usuarios ya confirmados o null, asegurando&lt;br&gt;que el log persista aunque se lance BusinessException (401/403).&lt;br&gt;3. maskSensitiveData oculta correos y teléfonos según RNF-SEC-04." mermaidId="n:_note_0" mermaidBaseStyle="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff5ad;strokeColor=#aaaa33;strokeWidth=1.3;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Transacciones del log (PostgreSQL READ_COMMITTED + FKs):&lt;br&gt;1. recordEvent usa @Transactional(propagation = REQUIRED) para participar en la&lt;br&gt;transacción principal, viendo userId/batchId/evaluationId recién insertados sin violar FKs.&lt;br&gt;2. recordSecurityFailure usa @Transactional(propagation = REQUIRES_NEW) exclusivamente&lt;br&gt;en LOGIN_FAILED / accesos denegados sobre usuarios ya confirmados o null, asegurando&lt;br&gt;que el log persista aunque se lance BusinessException (401/403).&lt;br&gt;3. maskSensitiveData oculta correos y teléfonos según RNF-SEC-04." id="59">
          <mxCell parent="83" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff5ad;strokeColor=#aaaa33;strokeWidth=1.3;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="526" width="232" x="604" y="10" as="geometry" />
          </mxCell>
        </UserObject>
