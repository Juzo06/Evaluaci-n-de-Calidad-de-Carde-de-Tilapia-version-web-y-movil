        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\r\ndirection LR\r\nclass Cliente_Web_Movil {\r\n  &lt;&lt;React / PWA · Bearer JWT&gt;&gt;\r\n  +Authorization: Bearer accessToken\r\n}\r\nclass AuthController_UserController_Sprint1 {\r\n  &lt;&lt;HU-01 y HU-02&gt;&gt;\r\n  +POST /api/users (RegisterUserRequestDTO) 201\r\n  +POST /api/auth/login (LoginRequestDTO) 200\r\n  +POST /api/auth/logout 204\r\n}\r\nclass BatchController_EvaluationController_Sprint1 {\r\n  &lt;&lt;HU-03, HU-04 y HU-05&gt;&gt;\r\n  +POST /api/batches (RegisterBatchRequestDTO) 201\r\n  +GET /api/batches/available?estado=... 200\r\n  +GET /api/batches/evaluated 200\r\n  +GET /api/batches/{code} 200\r\n  +POST /api/evaluations/batches/{code}/units (multipart/form-data) 201\r\n  +POST /api/evaluations/batches/{code}/close 200\r\n}\r\nclass ReportController_Sprint2 {\r\n  &lt;&lt;HU-06, HU-10, HU-11, HU-12 y HU-14&gt;&gt;\r\n  +GET /api/reports/batches/{code} (HU-06 Generar vista previa) 200\r\n  +POST /api/reports/batches/{code} (HU-10 Guardar versión vigente) 201\r\n  +GET /api/reports?code=&amp;from=&amp;to=&amp;minClassification= (HU-11 Listar) 200\r\n  +GET /api/reports/{id} (HU-11 Consultar detalle) 200\r\n  +GET /api/reports/{id}/pdf (HU-12 Exportar application/pdf) 200\r\n  +DELETE /api/reports/{id} (HU-14 Borrado lógico) 204\r\n}\r\nclass Admin_User_Batch_Sprint2 {\r\n  &lt;&lt;HU-07, HU-08, HU-09 y HU-13&gt;&gt;\r\n  +GET /api/admin/system-info (HU-07 Totales del sistema) 200\r\n  +DELETE /api/users/me (HU-08 DeleteAccountRequestDTO) 204\r\n  +DELETE /api/batches/{code} (HU-09 Eliminar lote y cascada lógica) 204\r\n  +PATCH /api/batches/{code}/sample-size (HU-13 ExpandSampleRequestDTO) 200\r\n}\r\nCliente_Web_Movil --&gt; AuthController_UserController_Sprint1 : HTTP / JSON\r\nCliente_Web_Movil --&gt; BatchController_EvaluationController_Sprint1 : HTTP / JSON / Multipart\r\nCliente_Web_Movil --&gt; ReportController_Sprint2 : HTTP / JSON / PDF\r\nCliente_Web_Movil --&gt; Admin_User_Batch_Sprint2 : HTTP / JSON\r\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="41">
